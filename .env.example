# Copier en ".env" (jamais dans Git). Voir docs/GUIDE_DEPLOIEMENT.md.

APP_ENV=production
APP_URL=https://risfm.exemple.ci
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_FORCE_HTTPS=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=oipi_risfm
DB_USER=risfm_user
DB_PASS=change_me
# Compte de sauvegarde facultatif (sinon DB_USER est utilise)
# DB_MAINTENANCE_USER=risfm_backup
# DB_MAINTENANCE_PASS=change_me_backup

SESSION_NAME=RISFM_SESSION
ENABLE_LOGIN_OTP=true
ENABLE_CAPTCHA=false

MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@oipi.ci
MAIL_FROM_NAME="OIPI - RISFM"

ENABLE_MISSION_REMINDERS=true
REMINDER_CRON_SCHEDULE="0 8 * * *"

UPLOAD_MAX_MB=15
BACKUP_MAX_MB=250
