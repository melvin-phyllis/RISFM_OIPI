# Copier ce fichier en ".env" et renseigner vos valeurs reelles.
# Ne jamais commiter le fichier ".env" reel dans un depot public.

APP_NAME="OIPI - RISFM"
APP_ENV=production
APP_URL=https://risfm.exemple.ci
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan

# Sur cPanel, utiliser les valeurs exactes affichees dans MySQL Database Wizard.
# DB_HOST vaut generalement localhost et DB_NAME/DB_USER sont prefixes par le
# nom du compte cPanel (ex. compte_oipi_risfm et compte_risfm).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oipi_risfm
DB_USER=risfm_user
DB_PASS=change_me
DB_CHARSET=utf8mb4

# Facultatif : compte MySQL dedie aux sauvegardes/restaurations.
# A defaut, DB_USER/DB_PASS sont utilises.
DB_MAINTENANCE_USER=risfm_backup
DB_MAINTENANCE_PASS=change_me_backup

SESSION_LIFETIME_MINUTES=20
SESSION_NAME=RISFM_SESSION
# Ecrit derniere_activite au maximum une fois par minute. En cas de verrou,
# cette ecriture non critique est abandonnee apres une seconde.
SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=60
SESSION_ACTIVITY_LOCK_WAIT_SECONDS=1
# true : code de securite par e-mail obligatoire apres le mot de passe
# false : connexion directe apres validation du mot de passe
ENABLE_LOGIN_OTP=true

# CAPTCHA facultatif. Si active, le fournisseur et ses cles doivent etre
# configures selon l'implementation retenue.
ENABLE_CAPTCHA=false

# Protection contre les tentatives de connexion automatisees.
# Un compte est temporairement bloque apres 5 echecs sur 10 minutes.
LOGIN_IDENTIFIER_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
# Le seuil IP est volontairement plus eleve : plusieurs agents OIPI peuvent
# partager la meme adresse publique. Ne pas le reduire au seuil d'un compte.
LOGIN_IP_MAX_ATTEMPTS=30
# Les tentatives plus anciennes sont purgees par la maintenance quotidienne.
LOGIN_ATTEMPT_RETENTION_DAYS=30

# Sur cPanel, creer la boite dans Email Accounts et recopier les parametres de
# Connect Devices. Le couple habituel est 587/tls ou 465/ssl selon l'hebergeur.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@oipi.ci
MAIL_FROM_NAME="OIPI - RISFM"
# Reserve aux recettes automatisees : laisser false en exploitation.
MAIL_DRY_RUN=false

# Rappels automatiques des missions. Le premier réglage autorise le moteur ;
# le second définit l'horaire installé par scripts/reminder_scheduler.php.
ENABLE_MISSION_REMINDERS=true
REMINDER_CRON_SCHEDULE="0 8 * * *"

UPLOAD_MAX_MB=15
# Taille maximale d'un export SQL cree ou restaure. Aligner egalement les
# directives PHP upload_max_filesize et post_max_size sur cette valeur.
BACKUP_MAX_MB=250
