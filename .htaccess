# RISFM - redirection racine -> public/
# Si le DocumentRoot de votre vhost pointe deja sur /public, ce fichier est inutile.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Interdire l'acces direct aux dossiers sensibles depuis la racine
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|env)$">
        Require all denied
    </FilesMatch>
</IfModule>
